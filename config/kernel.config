# kernel.config — kconfig FRAGMENT for ft_linux (Linux 6.16.1, x86_64).
#
# Not a full .config: scripts/03_system/03_kernel.sh does
#     make defconfig                                  (generic x86_64 base)
#     scripts/kconfig/merge_config.sh -m .config <this file>
#     make olddefconfig
# and then checks that every option below survived the merge.
#
# Syntax: "CONFIG_X=y" / "CONFIG_X=\"str\"" to set, "# CONFIG_X is not set"
# to disable ("CONFIG_X=n" is NOT valid kconfig syntax).
#
# No CPU-specific tuning: defconfig targets generic x86-64, so the kernel
# runs on whatever CPU the evaluation PC has.

# ── Subject: login in the kernel version, hostname ──────────────────────────
CONFIG_LOCALVERSION="-everonel"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="everonel"

# ── Modules (loaded by eudev/kmod) ──────────────────────────────────────────
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ── LFS 12.4 §10.3 required/recommended options ─────────────────────────────
# CONFIG_WERROR is not set
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
# CONFIG_IKHEADERS is not set
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
# CONFIG_EXPERT is not set
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# CONFIG_UEVENT_HELPER is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 64-bit: PCI_MSI, then IRQ_REMAP, then X86_X2APIC
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IRQ_REMAP=y
CONFIG_X86_X2APIC=y

# ── Evaluation VM (VirtualBox: SATA/AHCI, Intel PRO/1000) ───────────────────
# Built in (=y), not modules: the root fs must be mountable without initramfs.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VGA_CONSOLE=y

# ── Filesystems / partitions ────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MSDOS_PARTITION=y
