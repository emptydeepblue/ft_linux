# Kernel Configuration for ft_linux
# Excerpt of the options that matter for this build. The full .config is
# produced with `make menuconfig` (or `make defconfig` as a starting point)
# in /usr/src/kernel-6.16.1 — see notes/steps/build/11_kernel_bootloader.md.
#
# Key configuration points for ft_linux:
# 1. CONFIG_LOCALVERSION embeds the student login → uname -r = 6.16.1-everonel
# 2. SATA + ext4 drivers built IN (=y), NOT as modules (=m), so the kernel can
#    mount its own root filesystem without an initramfs (avoids a boot panic)
# 3. Loadable module support enabled for eudev
# 4. Essential filesystems (ext4, proc, sysfs, tmpfs, devtmpfs) enabled

#
# General setup
#
CONFIG_LOCALVERSION="-everonel"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="everonel"

#
# Loadable module support
#
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

#
# Enable the block layer
#
CONFIG_BLOCK=y

#
# Processor type and features (x86_64)
#
CONFIG_64BIT=y
CONFIG_SMP=y

#
# Power management
#
CONFIG_ACPI=y
CONFIG_PM=y

#
# Bus options (PCI etc.)
#
CONFIG_PCI=y

#
# Networking support
#
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

#
# Device Drivers
#

# SCSI device support
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Serial ATA (SATA) support
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# Networking device support
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y

# Input device support
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# TTY and serial drivers
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Graphics support (for console)
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

#
# File systems
#
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

#
# Pseudo filesystems
#
CONFIG_PROC_SYSCTL=y

#
# Partition Types
#
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y

#
# Kernel hacking
#
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# Note: This is a minimal template
# Generate complete config with: make defconfig && make menuconfig
# Then copy to: cp .config /boot/config-$(uname -r)